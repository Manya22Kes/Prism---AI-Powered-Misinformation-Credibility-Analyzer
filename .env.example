# ==============================================================================
# PRISM DOCKER COMPOSE CONFIGURATION
# Copy this file to .env before running: docker compose up --build
# ==============================================================================

# Google Gemini API Credentials (Required)
# Obtain from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.7-flash

# Host Port Mappings (Optional defaults shown)
FRONTEND_PORT=80
BACKEND_PORT=5000
MONGO_PORT=27017

# Frontend Origin for CORS (Defaults to http://localhost)
FRONTEND_URL=http://localhost

# Optional: Path to Google Cloud Service Account JSON for Cloud Vision / Speech
# GOOGLE_APPLICATION_CREDENTIALS=./backend/credentials/your_service_account_key.json
